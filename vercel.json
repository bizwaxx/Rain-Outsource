{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/status.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/fields.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/openapi.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/stats.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/schedule.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/teams.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/tracks.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/rain.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/mcp.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/construction.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/llms.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/site.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/api/index.py"
    },
    {
      "src": "/(icon\\.svg|icon\\.png|icon-400\\.png|favicon\\.ico|favicon\\.svg|apple-touch-icon\\.png|robots\\.txt|sitemap\\.xml)",
      "dest": "/api/site.py"
    },
    {
      "src": "/(privacy|terms|switch)(\\.html)?/?",
      "dest": "/api/site.py"
    },
    {
      "src": "/switch/embed/?",
      "dest": "/api/site.py"
    },
    {
      "src": "/(switch\\.js|switch-embed\\.js)",
      "dest": "/api/site.py"
    },
    {
      "src": "/\\.well-known/mcp/server-card(\\.json)?",
      "dest": "/api/site.py"
    },
    {
      "src": "/health",
      "dest": "/api/index.py"
    },
    {
      "src": "/openapi.yaml",
      "dest": "/api/openapi.py"
    },
    {
      "src": "/v1/fields",
      "dest": "/api/fields.py"
    },
    {
      "src": "/v1/status",
      "dest": "/api/status.py"
    },
    {
      "src": "/v1/reports/?",
      "dest": "/api/status.py"
    },
    {
      "src": "/v1/schedule/check",
      "dest": "/api/schedule.py"
    },
    {
      "src": "/v1/teams/search",
      "dest": "/api/teams.py"
    },
    {
      "src": "/v1/teams/([^/]+)/games",
      "dest": "/api/teams.py"
    },
    {
      "src": "/v1/teams/([^/]+)/calendar\\.ics",
      "dest": "/api/teams.py"
    },
    {
      "src": "/v1/tracks/?",
      "dest": "/api/tracks.py"
    },
    {
      "src": "/v1/tracks/([^/]+)/(events|check|history)",
      "dest": "/api/tracks.py"
    },
    {
      "src": "/v1/tracks/([^/]+)/calendar\\.ics",
      "dest": "/api/tracks.py"
    },
    {
      "src": "/v1/rain/?",
      "dest": "/api/rain.py"
    },
    {
      "src": "/v1/nowcast/?",
      "dest": "/api/construction.py"
    },
    {
      "src": "/v1/go-no-go/?",
      "dest": "/api/construction.py"
    },
    {
      "src": "/v1/should-we-cancel/?",
      "dest": "/api/construction.py"
    },
    {
      "src": "/v1/construction/([^/]+)/?",
      "dest": "/api/construction.py"
    },
    {
      "src": "/mcp/?",
      "dest": "/api/mcp.py"
    },
    {
      "src": "/llms\\.txt",
      "dest": "/api/llms.py"
    },
    {
      "src": "/v1/stats",
      "dest": "/api/stats.py"
    },
    {
      "src": "/v1/admin/usage/?",
      "dest": "/api/stats.py"
    },
    {
      "src": "/v1/plans/?",
      "dest": "/api/status.py"
    },
    {
      "src": "/v1/account/?",
      "dest": "/api/status.py"
    },
    {
      "src": "/v1/batch/?",
      "dest": "/api/status.py"
    },
    {
      "src": "/v1/keys/?",
      "dest": "/api/status.py"
    },
    {
      "src": "/api/status",
      "dest": "/api/status.py"
    },
    {
      "src": "/api",
      "dest": "/api/index.py"
    }
  ]
}
