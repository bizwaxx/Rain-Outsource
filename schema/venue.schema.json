{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bizwaxx/Rain-Outsource/schema/venue.schema.json",
  "title": "Rainout Source venue",
  "description": "One outdoor venue (ball field, soccer complex, motocross track) supported by Rainout Source. Mirrored by rainout_agent/venue_schema.py, which the tests use.",
  "type": "object",
  "required": [
    "id",
    "field_name",
    "venue_type",
    "sport",
    "sports",
    "city",
    "state",
    "address",
    "coordinates",
    "coordinates_source",
    "operator",
    "surface",
    "drainage",
    "rainout_phone",
    "official_status_source_url",
    "weather_source",
    "aliases"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Stable slug, usually <city>-<state>-<venue>."
    },
    "field_name": {
      "type": "string",
      "minLength": 1
    },
    "venue_type": {
      "enum": [
        "ball_field",
        "soccer_complex",
        "motocross_track",
        "multipurpose_field"
      ]
    },
    "sport": {
      "type": "string",
      "description": "Legacy free-text sport label, kept for API compatibility."
    },
    "sports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "baseball",
          "softball",
          "soccer",
          "motocross",
          "multipurpose"
        ]
      }
    },
    "city": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "AL",
        "AK",
        "AZ",
        "AR",
        "CA",
        "CO",
        "CT",
        "DE",
        "DC",
        "FL",
        "GA",
        "HI",
        "ID",
        "IL",
        "IN",
        "IA",
        "KS",
        "KY",
        "LA",
        "ME",
        "MD",
        "MA",
        "MI",
        "MN",
        "MS",
        "MO",
        "MT",
        "NE",
        "NV",
        "NH",
        "NJ",
        "NM",
        "NY",
        "NC",
        "ND",
        "OH",
        "OK",
        "OR",
        "PA",
        "RI",
        "SC",
        "SD",
        "TN",
        "TX",
        "UT",
        "VT",
        "VA",
        "WA",
        "WV",
        "WI",
        "WY",
        "PR"
      ]
    },
    "address": {
      "type": "string",
      "minLength": 1
    },
    "coordinates": {
      "type": "object",
      "required": [
        "lat",
        "lon"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": 17.5,
          "maximum": 72
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": -64
        }
      }
    },
    "coordinates_source": {
      "type": "object",
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "enum": [
            "official_venue_source",
            "openstreetmap_cross_checked",
            "place_listing_cross_checked",
            "legacy"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "verified_on": {
          "type": "string",
          "format": "date"
        },
        "note": {
          "type": "string"
        }
      },
      "description": "Where the coordinates came from. Every method except legacy needs at least one public source URL and a verified_on date."
    },
    "operator": {
      "type": [
        "string",
        "null"
      ],
      "description": "Operator, owner or league running the venue; null when not verified."
    },
    "ownership_type": {
      "type": "string"
    },
    "surface": {
      "enum": [
        "grass",
        "artificial_turf",
        "dirt",
        "grass_with_dirt_infield",
        "mixed",
        "unknown"
      ]
    },
    "drainage": {
      "enum": [
        "poor",
        "average",
        "good",
        "unknown"
      ],
      "description": "Scales the rain-to-cancel threshold (poor 0.75x, average 1x, good 1.5x)."
    },
    "rain_to_cancel_threshold_in": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "rainout_phone": {
      "type": "string",
      "description": "Published rainout line, or not_published."
    },
    "official_status_source_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "official_status_source_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "status_source_type": {
      "type": "string"
    },
    "poll_official_status": {
      "type": "boolean"
    },
    "weather_source": {
      "type": "string"
    },
    "aliases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "agent_rule": {
      "type": "string"
    }
  }
}
