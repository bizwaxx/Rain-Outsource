    }
   }
  },
  "freestone-2024-05-18": {
   "track": "freestone",
   "event_name": "FMF Texas Night Series",
   "start": "2024-05-18T17:00",
   "end": "2024-05-18T23:00",
   "source_url": "https://freestonemx.com/latest-news/tns-may-18-canceled/",
   "post": {
    "date": "2024-05-17T08:01:29",
    "link": "https://freestonemx.com/latest-news/tns-may-18-canceled/",
    "title": {
     "rendered": "TNS May 18 Canceled"
    },
    "content": {
     "rendered": "\n<p>25th Annual FMF Texas Night Series at Freestone is canceled this weekend May 18th. We have received too much rain at the track last night and the track wont be recoverable by tomorrow. We will post an update when we have one. </p>\n\n\n\n<figure class=\"wp-block-image size-large\"><img src=\"http://freestonemx.com/wp-content/uploads/Flyer-TNS-2024-rnd-3-cancled-802x1024.jpg\" alt=\"\" class=\"wp-image-29933\"/></figure>\n"
    }
   }
  },
  "freestone-practice-2025-03-29": {
   "track": "freestone",
   "event_name": "Practice",
   "start": "2025-03-29T08:00",
   "end": "2025-03-29T17:00",
   "source_url": "https://freestonemx.com/latest-news/practice-canceled-march-29-10/",
   "post": {
    "date": "2025-03-27T12:06:32",
    "link": "https://freestonemx.com/latest-news/practice-canceled-march-29-10/",
    "title": {
     "rendered": "PRACTICE CANCELED MARCH 29-30"
    },
    "content": {
     "rendered": "\n<p>We are canceling practice due to the rain we&#8217;ve got and more coming. We&#8217;ve had people concerned about track conditions. We want everyone to have a good time. We&#8217;ll schedule another weekend for a small practice. </p>\n\n\n\n<figure class=\"wp-block-image size-large\"><img data-attachment-id=\"34640\" data-permalink=\"https://freestonemx.com/latest-news/practice-canceled-march-29-10/attachment/canceled-practice-3-29-30/\" data-orig-file=\"https://freestonemx.com/wp-content/uploads/CANCELED-PRACTICE-3-29-30.jpg\" data-orig-size=\"1080,1920\" data-comments-opened=\"0\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"CANCELED-PRACTICE-3-29-30\" data-image-description=\"\" data-medium-file=\"https://freestonemx.com/wp-content/uploads/CANCELED-PRACTICE-3-29-30-169x300.jpg\" data-large-file=\"https://freestonemx.com/wp-content/uploads/CANCELED-PRACTICE-3-29-30-576x1024.jpg\" src=\"https://freestonemx.com/wp-content/uploads/CANCELED-PRACTICE-3-29-30-576x1024.jpg\" alt=\"\" class=\"wp-image-34640\" srcset=\"https://freestonemx.com/wp-content/uploads/CANCELED-PRACTICE-3-29-30-576x1024.jpg 576w, https://freestonemx.com/wp-content/uploads/CANCELED-PRACTICE-3-29-30-169x300.jpg 169w, https://freestonemx.com/wp-content/uploads/CANCELED-PRACTICE-3-29-30-768x1365.jpg 768w, https://freestonemx.com/wp-content/uploads/CANCELED-PRACTICE-3-29-30-864x1536.jpg 864w, https://freestonemx.com/wp-content/uploads/CANCELED-PRACTICE-3-29-30-600x1067.jpg 600w, https://freestonemx.com/wp-content/uploads/CANCELED-PRACTICE-3-29-30.jpg 1080w\" sizes=\"(max-width: 576px) 100vw, 576px\" />